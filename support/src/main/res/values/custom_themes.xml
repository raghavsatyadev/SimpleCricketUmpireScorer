<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppThemeDay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="fontFamily">@font/app_fonts</item>
        <item name="android:fontFamily">@font/app_fonts</item>
    </style>

    <style name="AppTheme.Merged">
        <item name="fontFamily">@font/app_fonts</item>
        <item name="android:fontFamily">@font/app_fonts</item>
    </style>

    <style name="AppTheme.Merged.Login">
        <item name="android:windowBackground">@drawable/img_splash</item>
    </style>

    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFF</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:ignore="NewApi">
            #8F4C38
        </item>
        <item name="windowSplashScreenIconBackgroundColor">#8F4C38</item>
        <item name="postSplashScreenTheme">@style/AppTheme.Merged</item>
    </style>


</resources>
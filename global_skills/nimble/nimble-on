#!/usr/bin/env bash
# Starts the local decision tools at the start of a session, so the first nimble-ask or jgl call
# does not wait for a cold load: loads the model into Ollama (kept NIMBLE_KEEP_ALIVE, default
# 10m, after the last call) and starts the jgl proxy. Returns at once; the load runs in the
# background. Safe to run again. Does nothing when Ollama is not reachable.
#   nimble-on           # Claude Code runs this from the repo's SessionStart hook
d="$(cd "$(dirname "$0")" && pwd)"
url="${NIMBLE_URL:-http://127.0.0.1:11434}"; url="${url%/}"
model="${NIMBLE_MODEL:-nimble}"
[ "${NIMBLE_HOOKS:-1}" = "0" ] && exit 0
case "$url" in *:11434*) ;; *) echo "nimble-on: $url is not Ollama; nothing to load"; exit 0 ;; esac
curl -s -m 2 "$url/api/tags" >/dev/null 2>&1 || { echo "nimble-on: Ollama not reachable at $url"; exit 0; }
( curl -s -m 120 "$url/api/generate" \
    -d "{\"model\":\"$model\",\"keep_alive\":\"${NIMBLE_KEEP_ALIVE:-10m}\"}" >/dev/null 2>&1 & )
port="${JG_PROXY_PORT:-11435}"
if [ -f "$d/jg-nimble-proxy.mjs" ] && command -v node >/dev/null 2>&1 \
   && ! curl -s -m 1 "http://127.0.0.1:$port/api/v1/me" >/dev/null 2>&1; then
  mkdir -p "$HOME/.nimble"
  nohup node "$d/jg-nimble-proxy.mjs" >"$HOME/.nimble/jg-proxy.log" 2>&1 &
fi
echo "nimble-on: loading $model; jgl proxy on :$port. Use nimble-ask and jgl first (skill nimble)."
exit 0

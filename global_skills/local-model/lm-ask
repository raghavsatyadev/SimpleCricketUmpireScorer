#!/usr/bin/env bash
# Ask the local decision model (Nimble, Tev1 or Laya), or Jev when the text is too long for it, one
# question about text on stdin.
#
#   lm-ask yesno  "<question>"                       < file   -> "yes 0.97 local"
#   lm-ask choice "<question>" label="desc" ...      < file   -> "<label> 0.93 jev"
#
# Fields: answer, P(yes) or the chosen label's probability, backend (local | jev).
# Jev (paid) is used only when the input is longer than the local budget, or no local model
# answers, and a TypeSafe key is set. LOCAL_MODEL_ALLOW_JEV=0 forbids it for one call.
# Exit 0 = answered, 2 = no backend answered (read the text the normal way), 64 = usage.
# Env: see local-model.sh. LOCAL_MODEL_TIMEOUT (seconds, default 30) covers a cold model load.
set -u
d="$(dirname "$0")"
if [ -f "$d/local-model.sh" ]; then . "$d/local-model.sh"; else . "$d/../../scripts/local-model.sh"; fi
export LOCAL_MODEL_ALLOW_JEV="${LOCAL_MODEL_ALLOW_JEV:-1}" LOCAL_MODEL_CALLER=lm-ask

kind="${1:-}"; question="${2:-}"
[ -n "$kind" ] && [ -n "$question" ] || { sed -n '2,13p' "$0" >&2; exit 64; }
shift 2
q=$(printf '%s' "$question" | _lm_escape)

case "$kind" in
  yesno) qs=$(printf '{"a":{"type":"noul","instructions":"%s"}}' "$q") ;;
  choice)
    [ $# -ge 2 ] || { echo "choice needs at least two label=description pairs" >&2; exit 64; }
    crit=""
    for pair in "$@"; do
      label="${pair%%=*}"; desc="${pair#*=}"; [ "$desc" = "$pair" ] && desc="$label"
      crit="$crit${crit:+,}\"$(printf '%s' "$label" | _lm_escape)\":\"$(printf '%s' "$desc" | _lm_escape)\""
    done
    qs=$(printf '{"a":{"type":"choice","instructions":"%s","criteria":{%s}}}' "$q" "$crit") ;;
  *) echo "kind must be yesno or choice" >&2; exit 64 ;;
esac

in=$(mktemp); tmp=$(mktemp)
trap 'rm -f "$tmp" "$in"' EXIT
cat >"$in"
t0=$(date +%s%3N)

# One line per call in ~/.local-model/usage.log (LOCAL_MODEL_USAGE_LOG=0 turns it off):
# time, tool, ms, input bytes, answer, cwd, question. Never fails the call.
usage_log() {
  [ "${LOCAL_MODEL_USAGE_LOG:-1}" = 0 ] && return 0
  local f="${LOCAL_MODEL_USAGE_LOG_FILE:-$HOME/.local-model/usage.log}"
  mkdir -p "$(dirname "$f")" 2>/dev/null
  printf '%s\tlm-ask\t%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$(( $(date +%s%3N) - t0 ))" \
    "$(wc -c <"$in" | tr -d ' ')" "$1" "$PWD" "$(printf '%s' "$question" | tr '\t\r\n' '   ')" \
    >>"$f" 2>/dev/null
  return 0
}

out=""
if lm_ask "${LOCAL_MODEL_TIMEOUT:-30}" "$qs" <"$in" >"$tmp"; then
  resp=$(cat "$tmp")
  if [ "$kind" = yesno ]; then
    if v=$(lm_get "$resp" a noul); then
      if lm_ge "$v" 0.5; then out="yes $v $LOCAL_MODEL_BACKEND"; else out="no $v $LOCAL_MODEL_BACKEND"; fi
    fi
  elif c=$(lm_get "$resp" a choice); then
    p=$(lm_get "$resp" a p) || p="?"
    out="$c $p $LOCAL_MODEL_BACKEND"
  fi
fi
usage_log "${out:-failed}"
[ -n "$out" ] || exit 2
echo "$out"

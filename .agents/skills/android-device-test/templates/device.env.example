# .device-cache/devices/<serial>/device.env — written by `dev.sh setup`, one per handset.
# Every value is discovered; edit only to override. Delete the file to re-discover.
SERIAL=<adb serial, e.g. emulator-5554 or 192.168.x.x:5555>
APP_ID=<applicationId, from appIdProd in gradle/libs.versions.toml>
SCREEN_SIZE=<WxH from `wm size`, e.g. 1080x2400>
DENSITY=<dpi from `wm density`, e.g. 440>
MAIN_ACTIVITY=<launcher activity, LeakCanary filtered out, e.g. <pkg>.MainActivity>
ADB_BIN=<path to adb actually used>

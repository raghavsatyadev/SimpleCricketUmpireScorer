# memory/devices/<serial>/coords.tsv — written by `dev.sh tap`, read by `tap --fast`.
# key = <resumed activity>|<WxH>|<selector>   (tab-separated: key, x, y)
# An entry only applies on the same screen at the same resolution.
<pkg>/<pkg>.MainActivity|<WxH>|desc:Model	<x>	<y>
<pkg>/<pkg>.MainActivity|<WxH>|desc:Setup	<x>	<y>
<pkg>/<pkg>.MainActivity|<WxH>|text:Start Assistant	<x>	<y>
com.whatsapp/com.whatsapp.Conversation|<WxH>|id:entry	<x>	<y>
